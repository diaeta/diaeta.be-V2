<!DOCTYPE html>
<html lang="{{ lang or page.lang or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
      {% if title %}{{ title }}{% else %}{{ site.brand.name }}{% endif %}
    </title>
    {% if description %}
      <meta name="description" content="{{ description }}">
    {% endif %}

    {% set canonicalUrl = (page.url or '/') | url %}
    <link rel="canonical" href="{{ site.baseUrl }}{{ canonicalUrl }}">

    <!-- Header Design System CSS -->
    <link rel="stylesheet" href="/assets/css/main.css">
    
    <!-- Basic utility styles -->
    <style>
      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.25rem, 5vw, 2.5rem);
      }
    </style>

    {% if head_extra %}{{ head_extra | safe }}{% endif %}
  </head>
  <body>
    <!-- Skip link for accessibility -->
    <a href="#main-content" class="u-skip-link">Skip to main content</a>
    
    <!-- Header Navigation -->
    {% include "partials/header.njk" %}
    
    <main id="main-content">
      {{ content | safe }}
    </main>
    
    <!-- Footer -->
    {% include "partials/footer.njk" %}
    
    <!-- Header Navigation JavaScript -->
    <script src="/assets/js/header.js"></script>

    <!-- Hero Section JavaScript -->
    <script src="/assets/js/hero.js"></script>
  </body>
</html>