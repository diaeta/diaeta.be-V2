{# Get current language or default to 'en' #}
{% set currentLang = lang or page.lang or 'en' %}
{% set t = approach[currentLang] %}

<!-- ============================================================================
  APPROACH SECTION - Unique Blueprint Design
  Asymmetric layout with numbered features, promise panel, and testimonial integration
  SEO-optimized, AISO-friendly, fully internationalized
============================================================================= -->
<section class="c-approach" id="approach" aria-labelledby="approach-title">

  <!-- Decorative background elements -->
  <div class="c-approach__bg" aria-hidden="true">
    <div class="c-approach__blob c-approach__blob--1"></div>
    <div class="c-approach__blob c-approach__blob--2"></div>
    <div class="c-approach__grid-pattern"></div>
  </div>

  <div class="c-approach__container">

    <!-- Header with promise panel -->
    <div class="c-approach__intro">
      <header class="c-approach__header">
        <p class="c-approach__eyebrow">{{ t.eyebrow }}</p>
        <h2 id="approach-title" class="c-approach__title">{{ t.title }}</h2>
        <p class="c-approach__subtitle">{{ t.subtitle }}</p>
      </header>

      <!-- Promise panel - floating card with glass effect -->
      <aside class="c-approach__promise glass-panel" aria-label="Our promise to you">
        <h3 class="c-approach__promise-title">{{ t.promise.title }}</h3>
        <ul class="c-approach__promise-list">
          {% for point in t.promise.points %}
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>{{ point }}</span>
          </li>
          {% endfor %}
        </ul>
      </aside>
    </div>

    <!-- Features - Numbered asymmetric grid -->
    <div class="c-approach__features" role="list">
      {% for feature in t.features %}
      <article class="c-approach__feature c-approach__feature--{{ loop.index }}" role="listitem">
        <!-- Large number decoration -->
        <span class="c-approach__feature-number" aria-hidden="true">{{ feature.number }}</span>

        <div class="c-approach__feature-icon" aria-hidden="true">
          {% if feature.icon == 'microscope' %}
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/>
            <path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/>
            <path d="M12 6V3a1 1 0 0 0-2 0v3"/>
          </svg>
          {% elif feature.icon == 'body' %}
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="5" r="3"/><path d="M12 8v13"/><path d="M6 11l6 2 6-2"/>
            <path d="M6 17l6 2 6-2"/><path d="M9 21h6"/>
          </svg>
          {% elif feature.icon == 'chef-hat' %}
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/>
            <line x1="6" y1="17" x2="18" y2="17"/>
          </svg>
          {% elif feature.icon == 'mobile-heart' %}
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
            <path d="M12 18h.01"/>
            <path d="M10.5 8.5c1.5-1.5 3.5-1.5 5 0s1.5 3.5 0 5l-2.5 2.5-2.5-2.5c-1.5-1.5-1.5-3.5 0-5z"/>
          </svg>
          {% endif %}
        </div>

        <div class="c-approach__feature-content">
          <h3 class="c-approach__feature-title">{{ feature.title }}</h3>
          <p class="c-approach__feature-description">{{ feature.description }}</p>
          <p class="c-approach__feature-highlight">{{ feature.highlight }}</p>

          <div class="c-approach__feature-metrics">
            {% for metric in feature.metrics %}
            <span class="c-approach__metric-badge">{{ metric }}</span>
            {% endfor %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>

    <!-- Stats Section - Redesigned -->
    <div class="c-approach__stats-section" role="region" aria-labelledby="stats-title">
      <div class="c-approach__stats-header">
        <h3 id="stats-title" class="c-approach__stats-title">{{ t.stats.title }}</h3>
        <p class="c-approach__stats-subtitle">{{ t.stats.subtitle }}</p>
      </div>

      <div class="c-approach__stats-grid">
        {% for metric in t.stats.metrics %}
        <div class="c-approach__stat-card">
          <div class="c-approach__stat-icon" aria-hidden="true">
            {% if metric.icon == 'scale' %}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
            </svg>
            {% elif metric.icon == 'heart-pulse' %}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              <path d="M3.22 12h3.27l2 4.54 2.73-12.08 2.73 7.54H19"/>
            </svg>
            {% elif metric.icon == 'trophy' %}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
              <path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
              <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
            </svg>
            {% elif metric.icon == 'users' %}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            {% endif %}
          </div>
          <div class="c-approach__stat-value">{{ metric.value }}</div>
          <div class="c-approach__stat-label">{{ metric.label }}</div>
          <div class="c-approach__stat-sublabel">{{ metric.sublabel }}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    <!-- Testimonial highlight -->
    <blockquote class="c-approach__testimonial">
      <svg class="c-approach__quote-mark" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
      </svg>
      <p class="c-approach__testimonial-quote">{{ t.testimonial.quote }}</p>
      <footer class="c-approach__testimonial-footer">
        <cite class="c-approach__testimonial-author">{{ t.testimonial.author }}</cite>
        <span class="c-approach__testimonial-role">{{ t.testimonial.role }}</span>
      </footer>
    </blockquote>

    <!-- CTA Buttons -->
    <div class="c-approach__ctas">
      <a href="{{ t.cta.primary.url }}" class="c-approach__cta c-approach__cta--primary">
        <span>{{ t.cta.primary.text }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
      <a href="{{ t.cta.secondary.url }}" class="c-approach__cta c-approach__cta--secondary">
        <span>{{ t.cta.secondary.text }}</span>
      </a>
    </div>

  </div>
</section>
