{# =============================================================================
   PHILOSOPHY SECTION - Clinical Science Meets Human Experience
   Mind-blowing split-screen design with manifesto cards and pillar grid
   ============================================================================= #}

{% set currentLang = lang or page.lang or 'en' %}
{% set data = philosophy[currentLang] %}

<section id="philosophy" class="c-philosophy" aria-labelledby="philosophy-title">
  <div class="c-philosophy__container">

    {# Header #}
    <header class="c-philosophy__header">
      <p class="c-philosophy__eyebrow">{{ data.eyebrow }}</p>
      <h2 id="philosophy-title" class="c-philosophy__title">{{ data.title }}</h2>
      <p class="c-philosophy__subtitle">{{ data.subtitle }}</p>
    </header>

    {# Manifesto Section - Split Layout #}
    <div class="c-philosophy__manifesto">
      <div class="c-philosophy__manifesto-header">
        <h3 class="c-philosophy__manifesto-title">{{ data.manifesto.title }}</h3>
        <div class="c-philosophy__manifesto-decoration" aria-hidden="true">
          <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
            <circle cx="30" cy="30" r="28" stroke="currentColor" stroke-width="2" opacity="0.3"/>
            <circle cx="30" cy="30" r="20" stroke="currentColor" stroke-width="2" opacity="0.5"/>
            <circle cx="30" cy="30" r="12" fill="currentColor" opacity="0.7"/>
          </svg>
        </div>
      </div>

      <div class="c-philosophy__principles">
        {% for principle in data.manifesto.principles %}
        <article class="c-philosophy__principle">
          <div class="c-philosophy__principle-number" aria-hidden="true">{{ principle.number }}</div>
          <div class="c-philosophy__principle-content">
            <h4 class="c-philosophy__principle-title">{{ principle.title }}</h4>
            <p class="c-philosophy__principle-description">{{ principle.description }}</p>
          </div>
          <div class="c-philosophy__principle-arrow" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>

    {# Pillars Grid #}
    <div class="c-philosophy__pillars">
      {% for pillar in data.pillars %}
      <article class="c-philosophy__pillar">
        <div class="c-philosophy__pillar-icon" aria-hidden="true">
          {% if pillar.icon == 'brain' %}
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M12 2a7 7 0 0 1 5 2c1.3 1.3 2 3 2 5v4c0 2-.7 3.7-2 5a7 7 0 0 1-5 2 7 7 0 0 1-5-2c-1.3-1.3-2-3-2-5V9c0-2 .7-3.7 2-5a7 7 0 0 1 5-2z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M9 10v2M15 10v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M9 16c.8.7 1.8 1 3 1s2.2-.3 3-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {% elif pillar.icon == 'heart-pulse' %}
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1 7.8 7.8 7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M8 12h2l1.5 2L13 10l1.5 2H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {% elif pillar.icon == 'puzzle-piece' %}
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M19.5 13h-3a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zM12.5 6H15a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5h-2.5v-4zM8 10H5.5a.5.5 0 0 0-.5.5V13c0 .3.2.5.5.5H8v-3.5zM12 17v2.5a.5.5 0 0 0 .5.5H15a.5.5 0 0 0 .5-.5V17H12z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          {% elif pillar.icon == 'infinity' %}
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M18.2 9.8c-1.5-1.5-4-.5-5.7 1.2-1.7 1.7-2.7 4.2-1.2 5.7 1.5 1.5 4 .5 5.7-1.2 1.7-1.7 2.7-4.2 1.2-5.7zM5.8 9.8c1.5-1.5 4-.5 5.7 1.2 1.7 1.7 2.7 4.2 1.2 5.7-1.5 1.5-4 .5-5.7-1.2-1.7-1.7-2.7-4.2-1.2-5.7z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          {% endif %}
        </div>

        <div class="c-philosophy__pillar-badge">{{ pillar.highlight }}</div>
        <h3 class="c-philosophy__pillar-title">{{ pillar.title }}</h3>
        <p class="c-philosophy__pillar-description">{{ pillar.description }}</p>

        <div class="c-philosophy__pillar-corner" aria-hidden="true"></div>
      </article>
      {% endfor %}
    </div>

    {# Quote Section #}
    <div class="c-philosophy__quote">
      <div class="c-philosophy__quote-mark" aria-hidden="true">"</div>
      <blockquote class="c-philosophy__quote-text">
        {{ data.quote.text }}
      </blockquote>
      <cite class="c-philosophy__quote-author">— {{ data.quote.author }}</cite>
    </div>

    {# CTA Section #}
    <div class="c-philosophy__cta">
      <a href="{{ data.cta.primary.url }}" class="c-philosophy__cta-primary">
        {{ data.cta.primary.text }}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </a>
      <a href="{{ data.cta.secondary.url }}" class="c-philosophy__cta-secondary">
        {{ data.cta.secondary.text }}
      </a>
    </div>

  </div>

  {# Decorative Background Elements #}
  <div class="c-philosophy__bg-circles" aria-hidden="true">
    <span class="c-philosophy__bg-circle c-philosophy__bg-circle--1"></span>
    <span class="c-philosophy__bg-circle c-philosophy__bg-circle--2"></span>
    <span class="c-philosophy__bg-circle c-philosophy__bg-circle--3"></span>
  </div>
</section>
