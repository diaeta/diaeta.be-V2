{# =============================================================================
   FOOTER - Comprehensive Multi-Column Design
   Epic footer with navigation, newsletter, social proof, certifications
   ============================================================================= #}

{% set data = footer[locale] %}

<footer class="c-footer" role="contentinfo">

  {# Main Footer Content #}
  <div class="c-footer__main">
    <div class="c-footer__container">

      {# Brand Column #}
      <div class="c-footer__brand">
        <a href="{{ '/' + locale + '/' }}" class="c-footer__logo" aria-label="Diaeta Home">
          <img src="/assets/images/logo.svg" alt="Diaeta" width="150" height="40">
        </a>
        <p class="c-footer__tagline">{{ data.brand.tagline }}</p>
        <p class="c-footer__description">{{ data.brand.description }}</p>

        {# Certifications #}
        <div class="c-footer__certifications">
          {% for cert in data.certifications %}
          <div class="c-footer__cert-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              {% if cert.icon == 'monash' or cert.icon == 'diploma' or cert.icon == 'inbody' %}
              <path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.3-6.2 3.3 1.2-6.8-5-4.9 6.9-1z" fill="currentColor"/>
              {% endif %}
            </svg>
            {{ cert.name }}
          </div>
          {% endfor %}
        </div>
      </div>

      {# Navigation Columns #}
      <nav class="c-footer__nav" aria-label="Footer navigation">
        {# Programs Column #}
        <div class="c-footer__column">
          <h3 class="c-footer__column-title">{{ data.programs.title }}</h3>
          <ul class="c-footer__links">
            {% for link in data.programs.links %}
            <li><a href="{{ link.url }}">{{ link.text }}</a></li>
            {% endfor %}
          </ul>
        </div>

        {# Company Column #}
        <div class="c-footer__column">
          <h3 class="c-footer__column-title">{{ data.company.title }}</h3>
          <ul class="c-footer__links">
            {% for link in data.company.links %}
            <li><a href="{{ link.url }}">{{ link.text }}</a></li>
            {% endfor %}
          </ul>
        </div>

        {# Resources Column #}
        <div class="c-footer__column">
          <h3 class="c-footer__column-title">{{ data.resources.title }}</h3>
          <ul class="c-footer__links">
            {% for link in data.resources.links %}
            <li><a href="{{ link.url }}">{{ link.text }}</a></li>
            {% endfor %}
          </ul>
        </div>

        {# Legal Column #}
        <div class="c-footer__column">
          <h3 class="c-footer__column-title">{{ data.legal.title }}</h3>
          <ul class="c-footer__links">
            {% for link in data.legal.links %}
            <li><a href="{{ link.url }}">{{ link.text }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </nav>

      {# Contact Column #}
      <div class="c-footer__contact">
        <h3 class="c-footer__column-title">{{ data.contact.title }}</h3>
        <ul class="c-footer__contact-list">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/>
              <path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="2"/>
            </svg>
            <a href="mailto:{{ data.contact.email }}">{{ data.contact.email }}</a>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3c.6-.5 1.4-.7 2.1-.5.9.3 1.9.6 2.9.7A2 2 0 0 1 22 16.9z" stroke="currentColor" stroke-width="2"/>
            </svg>
            <a href="tel:{{ data.contact.phone }}">{{ data.contact.phone }}</a>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>{{ data.contact.address }}</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
              <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span>{{ data.contact.hours }}</span>
          </li>
        </ul>

        {# Social Links #}
        <div class="c-footer__social">
          <h4 class="c-footer__social-title">{{ data.social.title }}</h4>
          <div class="c-footer__social-links">
            {% for social in data.social.links %}
            <a href="{{ social.url }}" aria-label="{{ social.platform }}" target="_blank" rel="noopener">
              {% if social.icon == 'facebook' %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
              {% elif social.icon == 'instagram' %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <circle cx="12" cy="12" r="4" fill="black"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="black"/>
              </svg>
              {% elif social.icon == 'linkedin' %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
              {% endif %}
            </a>
            {% endfor %}
          </div>
        </div>
      </div>

    </div>
  </div>

  {# Newsletter Bar #}
  <div class="c-footer__newsletter">
    <div class="c-footer__container">
      <div class="c-footer__newsletter-content">
        <div class="c-footer__newsletter-text">
          <h3 class="c-footer__newsletter-title">{{ data.newsletter.title }}</h3>
          <p class="c-footer__newsletter-subtitle">{{ data.newsletter.subtitle }}</p>
        </div>
        <form class="c-footer__newsletter-form" action="/api/subscribe" method="POST">
          <input
            type="email"
            name="email"
            class="c-footer__newsletter-input"
            placeholder="{{ data.newsletter.placeholder }}"
            required
            aria-label="Email address for newsletter"
          >
          <button type="submit" class="c-footer__newsletter-button">
            {{ data.newsletter.button }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </button>
        </form>
        <p class="c-footer__newsletter-privacy">{{ data.newsletter.privacy }}</p>
      </div>
    </div>
  </div>

  {# Bottom Bar #}
  <div class="c-footer__bottom">
    <div class="c-footer__container">
      <p class="c-footer__copyright">{{ data.bottom.copyright }}</p>
      <p class="c-footer__languages">{{ data.bottom.languages }}</p>
      <p class="c-footer__built">{{ data.bottom.built }}</p>
    </div>
  </div>

</footer>
