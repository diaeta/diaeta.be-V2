{# =============================================================================
   TESTIMONIALS SECTION - Real Stories, Real Results
   Immersive card-based testimonial showcase with stats
   ============================================================================= #}

{% set currentLang = lang or page.lang or 'en' %}
{% set data = testimonials[currentLang] %}

<section id="testimonials" class="c-testimonials" aria-labelledby="testimonials-title">
  <div class="c-testimonials__container">

    {# Header #}
    <header class="c-testimonials__header">
      <p class="c-testimonials__eyebrow">{{ data.eyebrow }}</p>
      <h2 id="testimonials-title" class="c-testimonials__title">{{ data.title }}</h2>
      <p class="c-testimonials__subtitle">{{ data.subtitle }}</p>
    </header>

    {# Testimonials Grid #}
    <div class="c-testimonials__grid">
      {% for testimonial in data.testimonials %}
      <article class="c-testimonials__card">
        <div class="c-testimonials__card-header">
          <div class="c-testimonials__avatar" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="30" fill="currentColor" opacity="0.1"/>
              <circle cx="30" cy="24" r="10" fill="currentColor" opacity="0.3"/>
              <path d="M15 50c0-8.3 6.7-15 15-15s15 6.7 15 15" fill="currentColor" opacity="0.3"/>
            </svg>
          </div>
          <div class="c-testimonials__meta">
            <h3 class="c-testimonials__name">{{ testimonial.name }}</h3>
            <p class="c-testimonials__program">{{ testimonial.program }}</p>
            <div class="c-testimonials__rating" aria-label="5 star rating">
              {% for i in range(0, 5) %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.3-6.2 3.3 1.2-6.8-5-4.9 6.9-1z"/>
              </svg>
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="c-testimonials__badge">{{ testimonial.highlight }}</div>

        <blockquote class="c-testimonials__quote">
          <div class="c-testimonials__quote-mark" aria-hidden="true">"</div>
          {{ testimonial.quote }}
        </blockquote>

        <div class="c-testimonials__results">
          <h4 class="c-testimonials__results-title">Key Results:</h4>
          <ul class="c-testimonials__results-list">
            {% for result in testimonial.results %}
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                <path d="M8 12l2.5 2.5L16 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
              {{ result }}
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="c-testimonials__location">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
          </svg>
          {{ testimonial.location }}
        </div>

        <div class="c-testimonials__decoration" aria-hidden="true"></div>
      </article>
      {% endfor %}
    </div>

    {# Stats Section #}
    <div class="c-testimonials__stats">
      <h3 class="c-testimonials__stats-title">{{ data.stats.title }}</h3>
      <div class="c-testimonials__stats-grid">
        {% for metric in data.stats.metrics %}
        <div class="c-testimonials__stat">
          <div class="c-testimonials__stat-icon" aria-hidden="true">
            {% if metric.icon == 'thumbs-up' %}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M7 22V11M2 13v6c0 1.1.9 2 2 2h1M16 6V3c0-1.1-.9-2-2-2s-2 .9-2 2l-2 6H5v11h11.3c.9 0 1.7-.6 1.9-1.5l2-8.5c.3-1.2-.6-2.5-1.9-2.5H16z" stroke="currentColor" stroke-width="2"/>
            </svg>
            {% elif metric.icon == 'calendar' %}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
              <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/>
            </svg>
            {% elif metric.icon == 'users' %}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" stroke="currentColor" stroke-width="2"/>
            </svg>
            {% elif metric.icon == 'star' %}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.3-6.2 3.3 1.2-6.8-5-4.9 6.9-1z"/>
            </svg>
            {% endif %}
          </div>
          <div class="c-testimonials__stat-number">{{ metric.number }}</div>
          <div class="c-testimonials__stat-label">{{ metric.label }}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    {# CTA Section #}
    <div class="c-testimonials__cta">
      <h3 class="c-testimonials__cta-title">{{ data.cta.title }}</h3>
      <p class="c-testimonials__cta-subtitle">{{ data.cta.subtitle }}</p>
      <div class="c-testimonials__cta-buttons">
        <a href="{{ data.cta.primary.url }}" class="c-testimonials__cta-primary">
          {{ data.cta.primary.text }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="{{ data.cta.secondary.url }}" class="c-testimonials__cta-secondary">
          {{ data.cta.secondary.text }}
        </a>
      </div>
    </div>

  </div>

  {# Background Decoration #}
  <div class="c-testimonials__bg-pattern" aria-hidden="true"></div>
</section>
