{# Get current language or default to 'en' #}
{% set currentLang = lang or page.lang or 'en' %}
{% set t = hero[currentLang] %}

<!-- ============================================================================
  HERO SECTION - Mind-blowing Professional Dietitian Hero
  Mobile-first, SEO-optimized, AISO-friendly, with animated elements
  Internationalized with i18n support
============================================================================= -->
<section class="c-hero" id="hero" data-hero data-lang="{{ currentLang }}">
  <!-- Animated gradient mesh background -->
  <div class="c-hero__bg-mesh" aria-hidden="true">
    <div class="c-hero__gradient-blob c-hero__gradient-blob--1"></div>
    <div class="c-hero__gradient-blob c-hero__gradient-blob--2"></div>
    <div class="c-hero__gradient-blob c-hero__gradient-blob--3"></div>
  </div>

  <div class="c-hero__container">
    <!-- Content Column -->
    <div class="c-hero__content">
      <!-- Trust badges floating -->
      <div class="c-hero__badges">
        <span class="c-hero__badge" data-badge="certified">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          {{ t.badges.certified }}
        </span>
        <span class="c-hero__badge" data-badge="languages">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          {{ t.badges.languages }}
        </span>
        <span class="c-hero__badge" data-badge="rating">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          {{ t.badges.rating }}
        </span>
      </div>

      <!-- Main heading with gradient text -->
      <h1 class="c-hero__title">
        <span class="c-hero__title-line">{{ t.title.line1 }}</span>
        <span class="c-hero__title-line c-hero__title-line--highlight">{{ t.title.line2 }}</span>
      </h1>

      <!-- Subtitle -->
      <p class="c-hero__subtitle">
        {{ t.subtitle | safe }}
      </p>

      <!-- Program selector - AISO optimized -->
      <div class="c-hero__programs" role="group" aria-label="Select your health goal">
        {% for key, program in t.programs %}
        <button
          class="c-hero__program-btn{% if loop.first %} is-active{% endif %}"
          data-program="{{ key }}"
          type="button"
          {% if loop.first %}aria-selected="true"{% endif %}>
          <span class="c-hero__program-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              {% if program.icon == 'activity' %}
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              {% elif program.icon == 'user-plus' %}
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="8.5" cy="7" r="4"/>
              <line x1="20" y1="8" x2="20" y2="14"/>
              <line x1="23" y1="11" x2="17" y2="11"/>
              {% elif program.icon == 'droplet' %}
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
              {% elif program.icon == 'heart' %}
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              {% endif %}
            </svg>
          </span>
          <span class="c-hero__program-label">{{ program.label }}</span>
        </button>
        {% endfor %}
      </div>

      <!-- Dynamic program details -->
      <div class="c-hero__details" id="hero-details" aria-live="polite">
        {% for key, program in t.programs %}
        <div class="c-hero__detail-card" data-program-detail="{{ key }}" {% if not loop.first %}style="display:none;"{% endif %}>
          <ul class="c-hero__benefits">
            {% for benefit in program.benefits %}
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {{ benefit }}
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>

      <!-- CTA Buttons -->
      <div class="c-hero__ctas">
        <a href="/{{ currentLang }}/appointment/" class="c-hero__cta c-hero__cta--primary">
          <span>{{ t.ctas.primary }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <a href="#programs" class="c-hero__cta c-hero__cta--secondary">
          <span>{{ t.ctas.secondary }}</span>
        </a>
      </div>

      <!-- Social proof stats -->
      <div class="c-hero__stats">
        <div class="c-hero__stat" data-stat="patients">
          <span class="c-hero__stat-number" data-count="300">{{ t.stats.patients.number }}</span>
          <span class="c-hero__stat-label">{{ t.stats.patients.label }}</span>
        </div>
        <div class="c-hero__stat" data-stat="sessions">
          <span class="c-hero__stat-number" data-count="1500">{{ t.stats.sessions.number }}</span>
          <span class="c-hero__stat-label">{{ t.stats.sessions.label }}</span>
        </div>
        <div class="c-hero__stat" data-stat="success">
          <span class="c-hero__stat-number">{{ t.stats.success.number }}</span>
          <span class="c-hero__stat-label">{{ t.stats.success.label }}</span>
        </div>
      </div>
    </div>

    <!-- Media Column -->
    <div class="c-hero__media">
      <!-- Main professional photo -->
      <figure class="c-hero__figure">
        <div class="c-hero__image-wrapper">
          <picture>
            <!-- Desktop 16:9 -->
            <source
              media="(min-width: 1024px)"
              type="image/avif"
              srcset="/assets/images/hero-processed/hero-crop-16-9-new.avif"
              sizes="50vw" />
            <source
              media="(min-width: 1024px)"
              type="image/webp"
              srcset="/assets/images/hero-processed/hero-crop-16-9-new.webp"
              sizes="50vw" />

            <!-- Mobile 4:5 -->
            <source
              media="(max-width: 1023px)"
              type="image/avif"
              srcset="/assets/images/hero-processed/hero-crop-4-5-new.avif"
              sizes="100vw" />
            <source
              media="(max-width: 1023px)"
              type="image/webp"
              srcset="/assets/images/hero-processed/hero-crop-4-5-new.webp"
              sizes="100vw" />

            <img
              src="/assets/images/hero-processed/hero-crop-16-9-new.webp"
              alt="{{ t.imageAlt }}"
              loading="eager"
              fetchpriority="high"
              width="1920"
              height="1080"
              class="c-hero__img" />
          </picture>

          <!-- Decorative gradient overlay -->
          <div class="c-hero__img-overlay" aria-hidden="true"></div>
        </div>

        <!-- Floating achievement cards -->
        <div class="c-hero__floating-cards" aria-hidden="true">
          <div class="c-hero__float-card c-hero__float-card--1" data-float="result">
            <span class="c-hero__float-icon">🎯</span>
            <span class="c-hero__float-text">
              <strong>{{ t.floatingCards.result.title }}</strong>
              <span>{{ t.floatingCards.result.subtitle }}</span>
            </span>
          </div>

          <div class="c-hero__float-card c-hero__float-card--2" data-float="certification">
            <span class="c-hero__float-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </span>
            <span class="c-hero__float-text">
              <strong>{{ t.floatingCards.certification.title }}</strong>
              <span>{{ t.floatingCards.certification.subtitle }}</span>
            </span>
          </div>

          <div class="c-hero__float-card c-hero__float-card--3" data-float="support">
            <span class="c-hero__float-icon">💬</span>
            <span class="c-hero__float-text">
              <strong>{{ t.floatingCards.support.title }}</strong>
              <span>{{ t.floatingCards.support.subtitle }}</span>
            </span>
          </div>
        </div>

        <!-- Particle system -->
        <div class="c-hero__particles" aria-hidden="true">
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
        </div>
      </figure>
    </div>
  </div>

  <!-- Scroll indicator -->
  <button class="c-hero__scroll" aria-label="{{ t.scroll.text }}" data-scroll-to="#programs">
    <span class="c-hero__scroll-text">{{ t.scroll.text }}</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </button>
</section>
