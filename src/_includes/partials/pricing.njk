{# Get current language or default to 'en' #}
{% set currentLang = lang or page.lang or 'en' %}
{% set data = pricing[currentLang] %}

<!-- ============================================================================
  PRICING SECTION - Transparent Consultation Fees
  Enhanced design with better visual hierarchy and icons
============================================================================= -->
<section id="pricing" class="c-pricing" aria-labelledby="pricing-title">
  <div class="c-pricing__container">

    <!-- Header -->
    <header class="c-pricing__header">
      <p class="c-pricing__eyebrow">{{ data.eyebrow or "Transparent Pricing" }}</p>
      <h2 id="pricing-title" class="c-pricing__title">{{ data.title }}</h2>
      <p class="c-pricing__subtitle">{{ data.subtitle }}</p>
    </header>

    <!-- Pricing Grid -->
    <div class="c-pricing__grid">
      {% for package in data.packages %}
      <article class="c-pricing__card">
        <div class="c-pricing__card-header">
          <h3 class="c-pricing__card-name">{{ package.name }}</h3>
          <div class="c-pricing__card-price">{{ package.price }}</div>
          <div class="c-pricing__card-duration">{{ package.duration }}</div>
        </div>

        <ul class="c-pricing__card-includes">
          {% for item in package.includes %}
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>{{ item }}</span>
          </li>
          {% endfor %}
        </ul>

        <div class="c-pricing__card-accent" aria-hidden="true"></div>
      </article>
      {% endfor %}
    </div>

    <!-- Reimbursement Note -->
    <aside class="c-pricing__reimbursement">
      <div class="c-pricing__reimbursement-icon" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 16v-4M12 8h.01"/>
        </svg>
      </div>
      <div class="c-pricing__reimbursement-content">
        <p class="c-pricing__note">{{ data.reimbursement.note }}</p>
      </div>
    </aside>

    <!-- CTA -->
    <div class="c-pricing__cta">
      <a href="{{ data.cta.url }}" class="c-pricing__cta-btn">
        <span>{{ data.cta.text }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

  </div>
</section>
