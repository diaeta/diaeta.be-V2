<!-- ============================================================================
  HERO SECTION - Mind-blowing Professional Dietitian Hero
  Mobile-first, SEO-optimized, AISO-friendly, with animated elements
============================================================================= -->
<section class="c-hero" id="hero" data-hero>
  <!-- Animated gradient mesh background -->
  <div class="c-hero__bg-mesh" aria-hidden="true">
    <div class="c-hero__gradient-blob c-hero__gradient-blob--1"></div>
    <div class="c-hero__gradient-blob c-hero__gradient-blob--2"></div>
    <div class="c-hero__gradient-blob c-hero__gradient-blob--3"></div>
  </div>

  <div class="c-hero__container">
    <!-- Content Column -->
    <div class="c-hero__content">
      <!-- Trust badges floating -->
      <div class="c-hero__badges">
        <span class="c-hero__badge" data-badge="certified">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          Monash-Certified
        </span>
        <span class="c-hero__badge" data-badge="languages">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          EN · FR · NL · DE · AR
        </span>
        <span class="c-hero__badge" data-badge="rating">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          4.9/5 Rating
        </span>
      </div>

      <!-- Main heading with gradient text -->
      <h1 class="c-hero__title">
        <span class="c-hero__title-line">Transform your health</span>
        <span class="c-hero__title-line c-hero__title-line--highlight">with personalized nutrition</span>
      </h1>

      <!-- Subtitle -->
      <p class="c-hero__subtitle">
        Evidence-based programs for <strong>IBS</strong>, <strong>weight loss</strong>, <strong>diabetes</strong> and <strong>cholesterol</strong>—no restrictive diets, just sustainable results you can maintain.
      </p>

      <!-- Program selector - AISO optimized -->
      <div class="c-hero__programs" role="group" aria-label="Select your health goal">
        <button class="c-hero__program-btn is-active" data-program="ibs" type="button">
          <span class="c-hero__program-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </span>
          <span class="c-hero__program-label">IBS Relief</span>
        </button>
        <button class="c-hero__program-btn" data-program="weight" type="button">
          <span class="c-hero__program-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="8.5" cy="7" r="4"/>
              <line x1="20" y1="8" x2="20" y2="14"/>
              <line x1="23" y1="11" x2="17" y2="11"/>
            </svg>
          </span>
          <span class="c-hero__program-label">Weight Loss</span>
        </button>
        <button class="c-hero__program-btn" data-program="diabetes" type="button">
          <span class="c-hero__program-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
            </svg>
          </span>
          <span class="c-hero__program-label">Diabetes</span>
        </button>
        <button class="c-hero__program-btn" data-program="cholesterol" type="button">
          <span class="c-hero__program-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
          <span class="c-hero__program-label">Cholesterol</span>
        </button>
      </div>

      <!-- Dynamic program details -->
      <div class="c-hero__details" id="hero-details" aria-live="polite">
        <div class="c-hero__detail-card" data-program-detail="ibs">
          <ul class="c-hero__benefits">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Low-FODMAP mapping to identify your specific triggers
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Structured reintroduction protocol for food freedom
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Symptom tracking with personalized meal alternatives
            </li>
          </ul>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="c-hero__ctas">
        <a href="/en/appointment/" class="c-hero__cta c-hero__cta--primary">
          <span>Book Your Consultation</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <a href="#programs" class="c-hero__cta c-hero__cta--secondary">
          <span>Compare Programs</span>
        </a>
      </div>

      <!-- Social proof stats -->
      <div class="c-hero__stats">
        <div class="c-hero__stat" data-stat="patients">
          <span class="c-hero__stat-number" data-count="300">300+</span>
          <span class="c-hero__stat-label">Patients Guided</span>
        </div>
        <div class="c-hero__stat" data-stat="sessions">
          <span class="c-hero__stat-number" data-count="1500">1,500+</span>
          <span class="c-hero__stat-label">Sessions Completed</span>
        </div>
        <div class="c-hero__stat" data-stat="success">
          <span class="c-hero__stat-number">89%</span>
          <span class="c-hero__stat-label">Goal Achievement</span>
        </div>
      </div>
    </div>

    <!-- Media Column -->
    <div class="c-hero__media">
      <!-- Main professional photo -->
      <figure class="c-hero__figure">
        <div class="c-hero__image-wrapper">
          <picture>
            <!-- Desktop 16:9 -->
            <source
              media="(min-width: 1024px)"
              type="image/avif"
              srcset="/images/hero-processed/hero-crop-16-9-new.avif"
              sizes="50vw" />
            <source
              media="(min-width: 1024px)"
              type="image/webp"
              srcset="/images/hero-processed/hero-crop-16-9-new.webp"
              sizes="50vw" />

            <!-- Mobile 4:5 -->
            <source
              media="(max-width: 1023px)"
              type="image/avif"
              srcset="/images/hero-processed/hero-crop-4-5-new.avif"
              sizes="100vw" />
            <source
              media="(max-width: 1023px)"
              type="image/webp"
              srcset="/images/hero-processed/hero-crop-4-5-new.webp"
              sizes="100vw" />

            <img
              src="/images/hero-processed/hero-crop-16-9-new.webp"
              alt="Pierre Abou-Zeid, registered dietitian-nutritionist in Brussels, consulting with patient in a warm, professional clinical setting"
              loading="eager"
              fetchpriority="high"
              width="1920"
              height="1080"
              class="c-hero__img" />
          </picture>

          <!-- Decorative gradient overlay -->
          <div class="c-hero__img-overlay" aria-hidden="true"></div>
        </div>

        <!-- Floating achievement cards -->
        <div class="c-hero__floating-cards" aria-hidden="true">
          <div class="c-hero__float-card c-hero__float-card--1" data-float="result">
            <span class="c-hero__float-icon">🎯</span>
            <span class="c-hero__float-text">
              <strong>Sarah M.</strong>
              <span>Lost 18kg in 6 months</span>
            </span>
          </div>

          <div class="c-hero__float-card c-hero__float-card--2" data-float="certification">
            <span class="c-hero__float-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </span>
            <span class="c-hero__float-text">
              <strong>Monash Certified</strong>
              <span>IBS & Low-FODMAP Expert</span>
            </span>
          </div>

          <div class="c-hero__float-card c-hero__float-card--3" data-float="support">
            <span class="c-hero__float-icon">💬</span>
            <span class="c-hero__float-text">
              <strong>24/7 App Support</strong>
              <span>Between sessions</span>
            </span>
          </div>
        </div>

        <!-- Particle system -->
        <div class="c-hero__particles" aria-hidden="true">
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
          <span class="c-hero__particle"></span>
        </div>
      </figure>
    </div>
  </div>

  <!-- Scroll indicator -->
  <button class="c-hero__scroll" aria-label="Scroll to next section" data-scroll-to="#programs">
    <span class="c-hero__scroll-text">Explore programs</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </button>
</section>
